# Hostinger / Apache: SPA + API
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Dejar /api al proxy Node de Hostinger
  RewriteRule ^api(/|$) - [L]

  # Archivos reales (assets, index.html, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rutas de Vue → index.html (evita {"error":"Not Found"} al refrescar)
  RewriteRule ^ index.html [L]
</IfModule>
