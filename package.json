{
  "name": "correctly",
  "version": "0.1.0",
  "private": true,
  "description": "Correctly — seguimiento de bienestar diario",
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "db:push": "npm run db:push --prefix server",
    "db:generate": "npm run db:generate --prefix server",
    "postinstall": "npm install --prefix server && npm install --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
