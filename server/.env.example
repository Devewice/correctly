# Prisma (se puede omitir si USER+PASSWORD+HOST+NAME están)
DATABASE_URL=

# App
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# En Hostinger (panel):
# - NO definir PORT (Hostinger lo inyecta; si pones 3000 → 404)
# - NODE_ENV=production
# - CLIENT_URL=https://jeisson.click
# - DATABASE_URL con password encoded (no la palabra PASSWORD)
# - GOOGLE_CALLBACK_URL=https://jeisson.click/api/auth/google/callback  (sin :3000)

# Google OAuth (rellenar al configurar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# JWT
JWT_SECRET=change-me-to-a-long-random-string
