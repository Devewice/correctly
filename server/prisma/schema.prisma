generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(cuid())
  googleId             String?  @unique
  email                String   @unique
  name                 String
  avatar               String?  @db.VarChar(1000)
  role                 String   @default("user") // user | admin | superadmin
  timezone             String   @default("America/Bogota")
  language             String   @default("es") // es | en | pt
  units                String   @default("metric")
  wakeTime             String?  @db.VarChar(5)
  sleepTime            String?  @db.VarChar(5)
  mainGoal             String?
  activeModules        Json     @default("[\"meals\",\"water\",\"mood\",\"sleep\",\"habits\"]")
  /** Horarios aproximados de comidas: { breakfast, lunch, dinner } HH:mm */
  mealTimes            Json?
  /** Alarmas/recordatorios web: [{ id, type, time, enabled, withSound, label? }] */
  reminders            Json     @default("[]")
  onboardingCompleted  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  stats           UserStats?
  goals           Goal[]
  meals           MealLog[]
  waterLogs       WaterLog[]
  sleepLogs       SleepLog[]
  moodLogs        MoodLog[]
  activities      ActivityLog[]
  habits          HabitDefinition[]
  habitCompletions HabitCompletion[]
  meditations     MeditationLog[]
  weightLogs      WeightLog[]
  medications     Medication[]
  medicationLogs  MedicationLog[]
  journalEntries  JournalEntry[]
  achievements    Achievement[]
  friendInvites   FriendInvite[]  @relation("InviteCreator")
  friendshipsA    Friendship[]    @relation("FriendA")
  friendshipsB    Friendship[]    @relation("FriendB")
  dailyShares     DailyShare[]
  shareReactions  DailyShareReaction[]
  pushSubscriptions PushSubscription[]
  reminderFires   ReminderFire[]
}

/** Suscripción Web Push del navegador/dispositivo */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @db.VarChar(500)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  userAgent String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

/** Evita enviar el mismo recordatorio dos veces el mismo día */
model ReminderFire {
  id         String   @id @default(cuid())
  userId     String
  reminderId String   @db.VarChar(40)
  dateKey    String   @db.VarChar(10)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reminderId, dateKey])
  @@index([dateKey])
}

model UserStats {
  userId                   String  @id
  totalXP                  Int     @default(0)
  level                    Int     @default(1)
  currentStreak            Int     @default(0)
  bestStreak               Int     @default(0)
  streakFreezesRemaining   Int     @default(1)
  lastLogDate              String? @db.VarChar(10) // YYYY-MM-DD
  likesReceived            Int     @default(0)
  dislikesReceived         Int     @default(0)
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Código/enlace para agregar amigos (copiar enlace) */
model FriendInvite {
  id        String    @id @default(cuid())
  code      String    @unique @db.VarChar(24)
  creatorId String
  expiresAt DateTime?
  usedAt    DateTime?
  usedById  String?
  createdAt DateTime  @default(now())
  creator   User      @relation("InviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

/** Amistad aceptada (par ordenado userAId < userBId) */
model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA     User     @relation("FriendA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

/** Foto o nota del día — una por usuario; caduca a medianoche */
model DailyShare {
  id        String   @id @default(cuid())
  userId    String
  dateKey   String   @db.VarChar(10) // YYYY-MM-DD (timezone del usuario)
  note      String?  @db.VarChar(500)
  photoUrl  String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions DailyShareReaction[]

  @@unique([userId, dateKey])
  @@index([expiresAt])
  @@index([dateKey])
}

model DailyShareReaction {
  id        String   @id @default(cuid())
  shareId   String
  userId    String
  type      String   // like | dislike
  createdAt DateTime @default(now())
  share     DailyShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shareId, userId])
  @@index([userId])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  type      String   // water | sleep | activity | custom
  target    Float
  unit      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MealLog {
  id           String   @id @default(cuid())
  userId       String
  type         String   // breakfast | mid_morning | lunch | snack | dinner | night_snack
  loggedAt     DateTime @default(now())
  description  String?  @db.VarChar(500)
  photoUrl     String?  @db.VarChar(500)
  satisfaction Int?     // 1-5
  quality      Int?     // 1-5
  calories     Int?
  protein      Float?
  carbs        Float?
  fat          Float?
  tags         Json     @default("[]")
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model WaterLog {
  id           String   @id @default(cuid())
  userId       String
  amount       Int      // ml
  beverageType String   @default("water")
  loggedAt     DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model SleepLog {
  id            String    @id @default(cuid())
  userId        String
  bedTime       DateTime
  wakeTime      DateTime?
  durationMin   Int?
  quality       Int?      // 1-5
  interruptions Int?
  factors       Json      @default("[]")
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, bedTime])
}

model MoodLog {
  id         String   @id @default(cuid())
  userId     String
  mood       Int      // 1-5
  energy     String?  // low | medium | high
  stress     String?  // low | medium | high
  period     String?  // morning | afternoon | evening
  activities Json     @default("[]")
  notes      String?  @db.Text
  loggedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  type       String
  duration   Int      // minutes
  intensity  String?  // light | moderate | intense
  calories   Int?
  steps      Int?
  notes      String?  @db.Text
  loggedAt   DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model HabitDefinition {
  id           String   @id @default(cuid())
  userId       String
  name         String   @db.VarChar(120)
  icon         String?  @db.VarChar(40)
  color        String?  @db.VarChar(20)
  frequency    String   @default("daily") // daily | custom
  customDays   Json?    // [0-6] if custom
  reminderTime String?  @db.VarChar(5)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions  HabitCompletion[]

  @@index([userId])
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  date      String   @db.VarChar(10) // YYYY-MM-DD
  completed Boolean  @default(true)
  loggedAt  DateTime @default(now())
  habit     HabitDefinition @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
}

model MeditationLog {
  id       String   @id @default(cuid())
  userId   String
  duration Int      // minutes
  type     String   @default("free")
  feeling  String?
  loggedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model WeightLog {
  id           String   @id @default(cuid())
  userId       String
  weight       Float
  unit         String   @default("kg")
  measurements Json?
  notes        String?  @db.Text
  loggedAt     DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model Medication {
  id            String   @id @default(cuid())
  userId        String
  name          String   @db.VarChar(120)
  dosage        String?  @db.VarChar(80)
  frequency     String   @default("daily")
  reminderTimes Json     @default("[]")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          MedicationLog[]

  @@index([userId])
}

model MedicationLog {
  id           String   @id @default(cuid())
  medicationId String
  userId       String
  taken        Boolean  @default(true)
  loggedAt     DateTime @default(now())
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  content   String   @db.Text
  type      String   @default("free") // free | morning | evening
  prompt    String?  @db.VarChar(255)
  photoUrl  String?  @db.VarChar(500)
  loggedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String   @db.VarChar(60)
  unlockedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

/** Configuración global (Google OAuth, flags de wizard, etc.) */
model AppSetting {
  key       String   @id @db.VarChar(120)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?
}
